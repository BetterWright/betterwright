+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_FINGERPRINT_NOISE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_FINGERPRINT_NOISE_H_
+
+#include <cstddef>
+#include <cstdint>
+
+#include "third_party/blink/renderer/platform/platform_export.h"
+
+namespace blink {
+
+// BetterWright fork: deterministic fingerprint farbling.
+//
+// Enabled when the browser is launched with --fingerprint-platform=<mask>
+// (the same switch that gates the UA/platform/WebGL identity patches) and a
+// per-profile --fingerprint=<seed>. The noise is a pure function of
+// (seed, position): identical across restarts with the same profile and
+// distinct across seeds. Per-session randomization is itself a bot signal,
+// so nothing here may depend on time, PIDs, or RNG state.
+
+// True when a masked identity is active.
+PLATFORM_EXPORT bool FingerprintFarblingEnabled();
+
+// ±1 adjustment to one color channel per pixel (alpha untouched), keyed by
+// the profile seed and pixel position. `pixels` is an interleaved 4-byte
+// RGBA/BGRA buffer with `row_bytes` stride.
+PLATFORM_EXPORT void ApplyFingerprintCanvasNoise(uint8_t* pixels,
+                                                 int width,
+                                                 int height,
+                                                 size_t row_bytes);
+
+// ±5e-7 dither keyed by seed, sample index, and channel. Applied to the
+// OfflineAudioContext rendered buffer.
+PLATFORM_EXPORT void ApplyFingerprintAudioNoise(float* samples,
+                                                size_t sample_count,
+                                                uint64_t channel_index);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_FINGERPRINT_NOISE_H_

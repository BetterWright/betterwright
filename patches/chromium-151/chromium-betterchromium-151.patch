@@ -0,0 +1,92 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/graphics/fingerprint_noise.h"
+
+#include <algorithm>
+#include <string>
+
+#include "base/command_line.h"
+
+namespace blink {
+
+namespace {
+
+// FNV-1a over the profile seed string: stable across processes, builds, and
+// runs by construction (base::Hash is not guaranteed stable).
+uint64_t HashSeed(const std::string& seed) {
+  uint64_t h = 14695981039346656037ull;
+  for (const unsigned char c : seed) {
+    h ^= c;
+    h *= 1099511628211ull;
+  }
+  return h;
+}
+
+uint64_t SeedKey() {
+  static const uint64_t key = []() -> uint64_t {
+    const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+    if (cmd.GetSwitchValueASCII("fingerprint-platform").empty())
+      return uint64_t{0};
+    return HashSeed(cmd.GetSwitchValueASCII("fingerprint")) ^
+           uint64_t{0x9E3779B97F4A7C15ull};
+  }();
+  return key;
+}
+
+// splitmix64 finalizer: cheap, deterministic, well-distributed.
+uint64_t Mix(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ull;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+  return x ^ (x >> 31);
+}
+
+}  // namespace
+
+bool FingerprintFarblingEnabled() {
+  return SeedKey() != 0;
+}
+
+void ApplyFingerprintCanvasNoise(uint8_t* pixels,
+                                 int width,
+                                 int height,
+                                 size_t row_bytes) {
+  const uint64_t key = SeedKey();
+  if (!key || !pixels || width <= 0 || height <= 0)
+    return;
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = pixels + static_cast<size_t>(y) * row_bytes;
+    for (int x = 0; x < width; ++x) {
+      const uint64_t h =
+          Mix(key + static_cast<uint64_t>(y) * 0x100000000ull +
+              static_cast<uint64_t>(x));
+      const uint32_t channel = h & 3u;
+      if (channel == 3u)
+        continue;  // leave alpha exact
+      const bool up = (h & 4u) != 0;
+      uint8_t& v = row[static_cast<size_t>(x) * 4 + channel];
+      v = static_cast<uint8_t>(up ? std::min(255, v + 1)
+                                  : std::max(0, v - 1));
+    }
+  }
+}
+
+void ApplyFingerprintAudioNoise(float* samples,
+                                size_t sample_count,
+                                uint64_t channel_index) {
+  const uint64_t key = SeedKey();
+  if (!key || !samples)
+    return;
+  const uint64_t base_key =
+      Mix(key ^ (channel_index * 0x9E3779B97F4A7C15ull));
+  for (size_t i = 0; i < sample_count; ++i) {
+    const uint64_t h = Mix(base_key + i);
+    const float unit =
+        static_cast<float>((h >> 11) & 0xFFFF) / 65535.0f - 0.5f;
+    samples[i] += unit * 1e-6f;
+  }
+}
+
+}  // namespace blink

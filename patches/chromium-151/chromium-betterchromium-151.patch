+void ThreadDebuggerCommonImpl::scheduleInspectorWork(
+    std::function<void()> task) {
+  // Console reporting is routed here so the page-observed cost of console.*
+  // stays at the no-inspector baseline; the actual protocol serialization
+  // runs as an ordinary task on the isolate's V8 task runner.
+  pending_inspector_work_.push_back(std::move(task));
+  if (inspector_work_task_scheduled_) {
+    return;
+  }
+  inspector_work_task_scheduled_ = true;
+  ThreadScheduler::Current()->V8TaskRunner()->PostTask(
+      FROM_HERE, base::BindOnce(
+                     [](base::WeakPtr<ThreadDebuggerCommonImpl> self) {
+                       if (self) {
+                         self->flushPendingInspectorWork();
+                       }
+                     },
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ThreadDebuggerCommonImpl::flushPendingInspectorWork() {
+  inspector_work_task_scheduled_ = false;
+  std::vector<std::function<void()>> pending =
+      std::move(pending_inspector_work_);
+  pending_inspector_work_.clear();
+  for (std::function<void()>& work : pending) {
+    std::move(work)();
+  }
+}

+    // Canonical desktop profile when nothing overrides the geometry.
+    // BetterWright --fingerprint-platform=macos uses the capture-machine
+    // MacBook Pro 14" "More Space" display (1800x1169 @2x, availHeight 1049),
+    // and wins over --ozone-override-screen-size so Playwright/headless
+    // defaults cannot leave a 1920x1080 Linux tell.
+    const bool mac_mask =
+        command_line.GetSwitchValueASCII("fingerprint-platform") == "macos";
+    gfx::Rect bounds = GetHeadlessDisplayBounds();
+    if (mac_mask) {
+      // Physical pixels for CSS 1800x1169 at --force-device-scale-factor=2.
+      bounds.set_size(gfx::Size(3600, 2338));
+    } else if (bounds.size() == kHeadlessDisplaySize) {
+      bounds.set_size(gfx::Size(1920, 1080));
+    }
+    // Insets are in the same units as bounds. For the Mac mask that means
+    // physical px (39*2 menu, 81*2 Dock) so CSS availHeight stays 1049.
+    screen_info.push_back(HeadlessScreenInfo(
+        {.bounds = bounds,
+         .work_area_insets = mac_mask ? gfx::Insets::TLBR(78, 0, 162, 0)
+                                      : gfx::Insets::TLBR(28, 0, 0, 0),
+         .color_depth = 24,
+         .device_pixel_ratio = kHeadlessDisplayScale,
+         .is_internal = true}));
   }
   return screen_info;
 }

+bool IsSafeIanaTimezone(std::string_view timezone) {
+  if (timezone.empty() || timezone.front() == '/' ||
+      timezone.find("..") != std::string_view::npos ||
+      timezone.find('/') == std::string_view::npos) {
+    return false;
+  }
+  for (char c : timezone) {
+    if (!(base::IsAsciiAlphaNumeric(c) || c == '/' || c == '_' || c == '-' ||
+          c == '+' || c == '.')) {
+      return false;
+    }
+  }
+  return base::PathExists(
+      base::FilePath(FILE_PATH_LITERAL("/usr/share/zoneinfo"))
+          .Append(base::FilePath::FromASCII(timezone)));
+}
+
+std::string ExtractEgressTimezone(std::string_view output) {
+  constexpr std::string_view kTimezone = "\"timezone\"";
+  constexpr std::string_view kId = "\"id\"";
+  size_t position = output.find(kTimezone);
+  if (position == std::string_view::npos) {
+    return {};
+  }
+  position = output.find(kId, position + kTimezone.size());
+  if (position == std::string_view::npos) {
+    return {};
+  }
+  position = output.find(':', position + kId.size());
+  position = position == std::string_view::npos
+                 ? position
+                 : output.find('\"', position + 1);
+  if (position == std::string_view::npos) {
+    return {};
+  }
+  const size_t end = output.find('\"', position + 1);
+  if (end == std::string_view::npos) {
+    return {};
+  }
+  std::string timezone(output.substr(position + 1, end - position - 1));
+  return IsSafeIanaTimezone(timezone) ? timezone : std::string();
+}
+
+void MaybeAppendEgressTimezone(base::CommandLine* command_line) {
+  if (command_line->HasSwitch(switches::kProcessType) ||
+      command_line->HasSwitch(kBetterChromiumTimezoneProbe) ||
+      command_line->HasSwitch(switches::kBwTimezone) ||
+      command_line->HasSwitch(switches::kFingerprintTimezone)) {
+    return;
+  }
+
+  base::ScopedTempDir profile;
+  if (!profile.CreateUniqueTempDir(FILE_PATH_LITERAL("betterchromium-timezone"))) {
+    return;
+  }
+
+  // `timeout` bounds DNS, proxy negotiation, and the remote endpoint together.
+  // The child is this same binary with an isolated profile, so system, PAC, and
+  // command-line proxy routing are resolved by Chromium rather than by curl.
+  std::vector<std::string> probe = {
+      "/usr/bin/timeout", "15", command_line->GetProgram().value(),
+      "--headless", "--disable-gpu", "--no-first-run",
+      "--no-default-browser-check", "--disable-extensions", "--disable-sync",
+      "--disable-background-networking", "--metrics-recording-only",
+      "--bw-timezone-probe",
+      "--user-data-dir=" + profile.GetPath().value(), "--dump-dom"};
+  constexpr const char* kNetworkSwitches[] = {
+      "proxy-server", "proxy-pac-url", "proxy-bypass-list",
+      "host-resolver-rules", "host-rules", "auth-server-whitelist",
+      "auth-negotiate-delegate-whitelist", "ignore-certificate-errors",
+      "ignore-certificate-errors-spki-list", "no-sandbox"};
+  for (const char* name : kNetworkSwitches) {
+    if (!command_line->HasSwitch(name)) {
+      continue;
+    }
+    const std::string value = command_line->GetSwitchValueASCII(name);
+    probe.push_back(value.empty() ? "--" + std::string(name)
+                                  : "--" + std::string(name) + "=" + value);
+  }
+  probe.push_back("https://ipwho.is/?fields=success,timezone");
+
+  std::string output;
+  if (!base::GetAppOutput(probe, &output)) {
+    return;
+  }
+  const std::string timezone = ExtractEgressTimezone(output);
+  if (!timezone.empty()) {
+    command_line->AppendSwitchASCII(switches::kBwTimezone, timezone);
+  }
+}

   bool is_valid_ = false;
diff --git a/ui/display/mac/screen_mac_headless.mm b/ui/display/mac/screen_mac_headless.mm
index 07adf400a5..6c03b41c30 100644
--- a/ui/display/mac/screen_mac_headless.mm
+++ b/ui/display/mac/screen_mac_headless.mm
@@ -38,7 +38,31 @@ std::vector<headless::HeadlessScreenInfo> GetHeadlessScreenInfos() {
     CHECK(screen_infos_or_error.has_value()) << screen_infos_or_error.error();
     screen_infos = screen_infos_or_error.value();
   } else {
-    screen_infos.push_back(headless::HeadlessScreenInfo());
+    // Mirror the real primary display so headless sessions observe the same
+    // screen geometry, color depth and scale factor as a windowed session.
+    headless::HeadlessScreenInfo info;
+    if (NSScreen* screen = NSScreen.mainScreen) {
+      const NSRect frame = screen.frame;
+      const NSRect visible = screen.visibleFrame;
+      info.bounds = gfx::Rect(frame);
+      const int menu_inset =
+          static_cast<int>(frame.size.height - NSMaxY(visible));
+      const int left_inset = static_cast<int>(NSMinX(visible) - NSMinX(frame));
+      const int right_inset = static_cast<int>(NSMaxX(frame) - NSMaxX(visible));
+      const int bottom_inset =
+          static_cast<int>(NSMinY(visible) - NSMinY(frame));
+      info.work_area_insets =
+          gfx::Insets::TLBR(menu_inset, left_inset, bottom_inset, right_inset);
+      // Match ScreenMac's observable depth. Window depth remains 24-bit on
+      // HDR-capable displays, while regular Chromium exposes 30-bit color.
+      info.color_depth =
+          screen.maximumPotentialExtendedDynamicRangeColorComponentValue > 1.f
+              ? Display::kHDR10BitsPerPixel
+              : Display::kDefaultBitsPerPixel;
+      info.device_pixel_ratio = screen.backingScaleFactor;
+      info.is_internal = true;
+    }
+    screen_infos.push_back(info);
   }

   return screen_infos;

@@ -97,12 +100,43 @@ ImageDataBuffer::ImageDataBuffer(scoped_refptr<StaticBitmapImage> image) {
     MSAN_CHECK_MEM_IS_INITIALIZED(pixmap_.addr(), pixmap_.computeByteSize());
   }
   is_valid_ = true;
+  FarbleIfEnabled();
 }

 ImageDataBuffer::ImageDataBuffer(const SkPixmap& pixmap)
     : pixmap_(pixmap),
       is_valid_(pixmap_.addr() &&
-                !gfx::Size(pixmap.width(), pixmap.height()).IsEmpty()) {}
+                !gfx::Size(pixmap.width(), pixmap.height()).IsEmpty()) {
+  FarbleIfEnabled();
+}
+
+// BetterWright fork: route every canvas readback (toDataURL, toBlob,
+// OffscreenCanvas.convertToBlob, audits) through a private copy carrying
+// deterministic per-profile noise. peekPixels memory belongs to the source
+// image, so noise is never written in place; RasterFromData keeps the noisy
+// copy alive for encoders and PixelData() alike.
+void ImageDataBuffer::FarbleIfEnabled() {
+  if (!is_valid_ || !FingerprintFarblingEnabled())
+    return;
+  const SkImageInfo& info = pixmap_.info();
+  if (info.bytesPerPixel() != 4 || !pixmap_.addr())
+    return;
+  const int width = pixmap_.width();
+  const int height = pixmap_.height();
+  const size_t row_bytes = pixmap_.rowBytes();
+  const size_t byte_size = pixmap_.computeByteSize();
+  if (!byte_size)
+    return;
+  sk_sp<SkData> copy = SkData::MakeUninitialized(byte_size);
+  memcpy(copy->writable_data(), pixmap_.addr(), byte_size);
+  ApplyFingerprintCanvasNoise(static_cast<uint8_t*>(copy->writable_data()),
+                              width, height, row_bytes);
+  retained_image_ = SkImages::RasterFromData(info, std::move(copy), row_bytes);
+  if (!retained_image_ || !retained_image_->peekPixels(&pixmap_)) {
+    pixmap_.reset();
+    is_valid_ = false;
+  }
+}

 std::unique_ptr<ImageDataBuffer> ImageDataBuffer::Create(
     scoped_refptr<StaticBitmapImage> image) {

# The biome formatter is intentionally disabled (see biome.jsonc); this file
# records the hand-maintained style so editors keep new code consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-spaces for hard line breaks.
trim_trailing_whitespace = false

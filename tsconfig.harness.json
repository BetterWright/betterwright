// Everything that drives the built runtime: the test suite, the benchmark
// harnesses, and the probe scripts. All of it reaches `dist/src/*.js`, so this
// project only type-checks after `bun run build` — `bun run build:harness`
// chains the two in the right order.
//
// `dist/` ships no declaration files, so those imports resolve as `any`, which
// is exactly the checking these files had as JavaScript. Their own bodies are
// fully checked, and `noEmitOnError` means a type error fails the test run.
//
// Tests run as TypeScript under `bun test`, so this project is `--noEmit`
// via the build:harness script. The compilerOptions here still describe an
// in-place emit for anyone who wants the `.js` beside the `.ts`.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    // ES2024 (not the runtime tsconfig's ES2023) because the benchmark
    // harnesses use `Map.groupBy`, which Node 22 has and the shipped runtime
    // does not need.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  },
  "include": [
    "research/cdpfree-probe.ts",
    "research/creepjs-probe.ts",
    "research/headless-tells.ts",
    "research/pixelscan-probe.ts",
    "research/stealth-report.ts",
    "research/warm-profile.ts",
    "tests/node/**/*.ts",
    "benchmarks/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}

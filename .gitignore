# Node
node_modules/
npm-debug.log*

# Compiled development sources. tsconfig.tools.json and tsconfig.harness.json
# emit next to their .ts input on purpose: scripts resolve the repo root as
# `../`, the tests import the built runtime as `../../dist/src/*.js` and read
# `../fixtures/*`, and moving the output would break every one of those
# relative contracts.
scripts/*.js
tests/node/**/*.js
benchmarks/*/*.js
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/

# BetterWright runtime state (never commit a profile, vault, or artifacts)
.betterwright/
benchmarks/online-mind2web/runs/
benchmarks/online-mind2web/tasks.local.json
benchmarks/odysseys/runs/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local dev scratch (probes, font artifacts, handoff notes)
.tmp/
tmp/
artifacts/
*.tmp.mjs
logs/
captcha-probe/
tests/manual/
internal/

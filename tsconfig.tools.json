// Build and release tooling: the scripts that produce and verify `dist/`.
//
// This project is deliberately the half of the development sources that does
// NOT import the built runtime. `bun` runs the `.ts` scripts directly;
// `bun run build:tools` type-checks them without emitting. Anything that
// imports `../dist/src/*.js` belongs in tsconfig.harness.json instead; adding
// such an import here fails the typecheck on a clean tree, which is the
// intended alarm.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "legacy",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noEmitOnError": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false
  },
  "files": [
    "scripts/bench-runtime.ts",
    "scripts/build.ts",
    "scripts/check-build.ts",
    "scripts/check-package.ts",
    "scripts/check-versions.ts",
    "scripts/run-unit-tests.ts"
  ]
}
